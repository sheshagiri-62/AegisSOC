# ============================================================
# HFT SOC Lab — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored — never commit your real API key.
# ============================================================

# URL of your MISP instance
# Default: http://192.168.56.105:8081 (Ubuntu VM host-only IP)
MISP_URL=http://192.168.56.105:8081

# MISP API Authentication Key
# Get it from: MISP UI → Administration → List Auth Keys → Add Auth Key
MISP_KEY=your_misp_api_key_here
