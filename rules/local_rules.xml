<!-- ================================================================
     HFT SOC Lab — Custom Wazuh Rules
     Deploy to: /var/ossec/etc/rules/local_rules.xml
     (inside Wazuh manager container)

     NOTE: This file is auto-regenerated by ~/sync_misp.sh on the VM.
     The MISP IP list in rule 100021 is dynamically populated from MISP.
     Do NOT edit rule 100021 manually — run sync_misp.sh instead.
     ================================================================

     RULE MAP:
       100001 — SSH Login Failed (Level 5)
       100002 — SSH Brute Force: 5+ failures/60s (Level 10)
       100003 — Unauthorized Algorithm Modification (Level 12)
       100010 — Market Data API Request — network tracking (Level 3)
       100004 — HTTP Flood / DoS: 40+ req/30s same IP (Level 14)
       100021 — MISP IP in raw network traffic — CDB match (Level 15)
       100030 — MISP IOC Detected — CEF event from app.log (Level 12)
       100031 — MISP CRITICAL severity — C2/Ransomware IP (Level 15)
       100032 — SOAR Auto-Block — new IP blocked (Level 13)
       100033 — Blocked IP Repeat Attempt (Level 10)
     ================================================================ -->

<group name="custom_trading_logs, hft_platform,">

  <!-- ══════════════════════════════════════════════════════════════
       SSH / AUTHENTICATION RULES
       Source: auth.log → Windows Wazuh agent → Wazuh manager
       ══════════════════════════════════════════════════════════════ -->

  <!-- Fires on every single SSH authentication failure.
       Parent rule for brute force detection (100002).
       Wazuh built-in rule 5716 = "sshd: authentication failed" -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <description>SSH Login Failed Detected</description>
  </rule>

  <!-- Fires when the SAME IP fails SSH login 5+ times within 60 seconds.
       Triggered by dashboard: SSH Brute Force button (15 rapid failures).
       Composite rule — requires 100001 to fire first. -->
  <rule id="100002" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100001</if_matched_sid>
    <same_source_ip />
    <description>SSH Brute Force Attack Detected against HFT system</description>
  </rule>

  <!-- ══════════════════════════════════════════════════════════════
       APPLICATION RULES (app.log via hft_app_decoder)
       Source: app.log → Windows Wazuh agent → Wazuh manager
       CEF format: hft-app[pid]: CEF:0|SOCLab|HFT-Platform|1.0|100|<Event>|5|...
       ══════════════════════════════════════════════════════════════ -->

  <!-- Fires when an algorithm modification is logged as "Unauthorized".
       Triggered by dashboard: Modify Algorithm button (as Trader role).
       Admin role logs as "Authorized" — does not trigger this rule. -->
  <rule id="100003" level="12">
    <decoded_as>hft_app_decoder</decoded_as>
    <match>Unauthorized</match>
    <description>CRITICAL: Unauthorized Algorithm Modification Detected</description>
  </rule>

  <!-- ══════════════════════════════════════════════════════════════
       NETWORK TRAFFIC RULES (network.log via hft_network_decoder)
       Source: network.log → Windows Wazuh agent → Wazuh manager
       Format: hft-network[pid]: GET /api/<route> HTTP/1.1 from <ip>
       ══════════════════════════════════════════════════════════════ -->

  <!-- Fires on every market-data API hit. Level 3 = informational.
       Acts as parent for DoS detection (100004) and MISP match (100021).
       hft_network_decoder extracts srcip from the "from <ip>" field. -->
  <rule id="100010" level="3">
    <decoded_as>hft_network_decoder</decoded_as>
    <match>GET /api/public/market-data</match>
    <description>Market Data API Request Tracking</description>
  </rule>

  <!-- Fires when same IP hits /api/public/market-data 40+ times in 30 seconds.
       Triggered by dashboard: HTTP Flood button with count >= 40.
       Simulates DDoS against the HFT trading infrastructure. -->
  <rule id="100004" level="14" frequency="40" timeframe="30">
    <if_matched_sid>100010</if_matched_sid>
    <same_source_ip />
    <description>CRITICAL: Potential Web HTTP Flood / DoS Attack Detected</description>
  </rule>

  <!-- ══════════════════════════════════════════════════════════════
       MISP THREAT INTEL — CDB LIST MATCH (rule 100021)
       This rule is auto-updated by ~/sync_misp.sh on the VM.
       The <srcip> tags below are dynamically generated from MISP IPs.
       ══════════════════════════════════════════════════════════════ -->

  <!-- Fires when a network request comes from any MISP-tracked IP.
       Requires rule 100010 to fire first (network traffic detected).
       srcip is extracted by hft_network_decoder from network.log.
       IPs below are synced automatically from MISP by sync_misp.sh.
       Run ~/sync_misp.sh on the VM to update this list. -->
  <rule id="100021" level="15">
    <if_sid>100010</if_sid>
    <srcip>45.33.32.156</srcip>
    <srcip>185.220.101.34</srcip>
    <srcip>203.0.113.99</srcip>
    <srcip>188.166.26.195</srcip>
    <srcip>45.142.212.100</srcip>
    <srcip>91.240.118.168</srcip>
    <srcip>222.186.180.130</srcip>
    <srcip>103.99.115.220</srcip>
    <srcip>193.32.162.157</srcip>
    <srcip>185.217.131.88</srcip>
    <srcip>185.234.218.126</srcip>
    <srcip>5.188.206.25</srcip>
    <description>THREAT INTEL: Connection from MISP-flagged malicious IP $(srcip)</description>
    <group>threat_intel,misp_match,</group>
  </rule>

  <!-- ══════════════════════════════════════════════════════════════
       MISP + SOAR CEF EVENT RULES (100030–100033)
       All fire on app.log CEF events written by the Node.js backend.
       Decoded by hft_app_decoder (matches program_name: hft-app).
       ══════════════════════════════════════════════════════════════ -->

  <!-- Fires when our backend detects a MISP IP in live traffic.
       Backend writes: MISP_IOC_Detected to app.log each simulation tick.
       Fires once per MISP IP encounter (before or after blocking).
       Triggered by: Start Simulation, or Trigger MISP IPs button. -->
  <rule id="100030" level="12">
    <decoded_as>hft_app_decoder</decoded_as>
    <match>MISP_IOC_Detected</match>
    <description>MISP Threat Intel: Malicious IP detected in HFT network traffic</description>
    <group>threat_intel,misp,</group>
  </rule>

  <!-- Fires when a MISP IP with severity=CRITICAL is detected.
       Child of 100030 — requires MISP_IOC_Detected to fire first.
       CRITICAL IPs: 203.0.113.99 (C2), 185.217.131.88 (Ryuk ransomware),
                     185.234.218.126 (Mirai DDoS), 5.188.206.25 (DDoS-C2). -->
  <rule id="100031" level="15">
    <if_sid>100030</if_sid>
    <match>severity=CRITICAL</match>
    <description>MISP CRITICAL: C2 or Ransomware IP active in HFT environment</description>
    <group>threat_intel,misp,apt,ransomware,</group>
  </rule>

  <!-- Fires when SOAR auto-blocks a NEW IP for the first time.
       Backend writes: IP_Blocked with status=NEW_BLOCK to app.log.
       Fires once per IP per session (not on repeat attempts).
       Expected during simulation: 12 firings (one per MISP IP). -->
  <rule id="100032" level="13">
    <decoded_as>hft_app_decoder</decoded_as>
    <match>IP_Blocked</match>
    <description>SOAR Auto-Response: Malicious MISP IP blocked by automated containment</description>
    <group>soar,misp,block,</group>
  </rule>

  <!-- Fires when an ALREADY-BLOCKED IP tries to connect again.
       Backend writes: IP_Block_Repeated with status=DENIED_REPEAT.
       Fires continuously in second simulation pass (all 12 IPs blocked).
       Demonstrates persistent threat actor behavior. -->
  <rule id="100033" level="10">
    <decoded_as>hft_app_decoder</decoded_as>
    <match>IP_Block_Repeated</match>
    <description>SOAR: Previously blocked MISP IP attempted reconnection</description>
    <group>soar,misp,block_repeat,</group>
  </rule>

</group>